<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>LocalDictationInput</string>
	<key>CFBundleIdentifier</key>
	<string>com.omcdowell.inputmethod.LocalDictation</string>
	<key>CFBundleName</key>
	<string>Local Dictation</string>
	<key>CFBundleDisplayName</key>
	<string>Local Dictation</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.2.0</string>
	<key>CFBundleVersion</key>
	<string>5</string>
	<key>LSMinimumSystemVersion</key>
	<string>15.0</string>
	<key>LSBackgroundOnly</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<!-- Keyboard-type input method: selected while dictating (or kept
	     selected); it passes every key through with the user's layout. -->
	<key>InputMethodConnectionName</key>
	<string>com.omcdowell.inputmethod.LocalDictation_Connection</string>
	<key>InputMethodServerControllerClass</key>
	<string>LocalDictationInputController</string>
	<key>TISInputSourceID</key>
	<string>com.omcdowell.inputmethod.LocalDictation</string>
	<key>TISIntendedLanguage</key>
	<string>en</string>
	<key>tsInputMethodCharacterRepertoireKey</key>
	<array>
		<string>Latn</string>
		<string>Cyrl</string>
		<string>Grek</string>
	</array>
	<key>tsInputMethodIconFileKey</key>
	<string>MenuIcon.tiff</string>
	<key>TISIconIsTemplate</key>
	<true/>
	<!-- Apple's DictationIM declares its input-source icon with this system
	     microphone glyph; MenuIcon.tiff is the fallback. -->
	<key>CFBundleIcons</key>
	<dict>
		<key>ISGraphicIconConfiguration</key>
		<dict>
			<key>ISTypeIdentifier</key>
			<string>com.apple.graphic-icon.microphone</string>
		</dict>
	</dict>
</dict>
</plist>
